# Web App URL from deploying apps-script/Code.gs — see apps-script/README.md
VITE_SHEETS_API_URL=

# Google OAuth Client ID — see README for setup steps
VITE_GOOGLE_CLIENT_ID=

# Comma-separated list of emails allowed to sign in
VITE_ALLOWED_EMAILS=

# Patient portal toggle — set to "false" to disable the portal for this clinic
VITE_PORTAL_ENABLED=true

# Offer SMS as well as WhatsApp for the portal's one-time code. Off unless set
# to "true": the code works, but WhatsApp costs the clinic less and needs no
# Twilio account. Turning it on also needs twilioSid/twilioToken/twilioFrom.
VITE_PORTAL_SMS_OTP=false

# AWS Backend — shared across all clinics
VITE_AWS_API_URL=
VITE_CLINIC_ID=

# Show a patient their own past visits in the portal. On unless set to exactly
# "false" — a clinic that would rather the record stayed a conversation with
# the doctor can switch it off. The History tab, the visit-detail sheet and
# tapping a family member all go with it; today's visit is unaffected.
VITE_PORTAL_HISTORY=true
